# --- Aplication ---
HTTP_ADDR=:8080

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wallet
WALLET_OWNER_PASSWORD=wallet_owner_local
WALLET_APP_PASSWORD=wallet_app_local

# Aplication connection (role without DDL and without UPDATE/DELETE on the ledger).
DATABASE_URL=postgres://wallet_app:wallet_app_local@postgres:5432/wallet?sslmode=disable

# Migrations usage only (role with DDL and DML).
DATABASE_MIGRATE_URL=postgres://wallet_owner:wallet_owner_local@postgres:5432/wallet?sslmode=disable

DB_MAX_CONNS=10
DB_LOCK_TIMEOUT=5s
DB_STATEMENT_TIMEOUT=10s

# --- Keycloak (IdP) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# Expected "iss" of every token (Keycloak public URL, fixed by KC_HOSTNAME).
OIDC_ISSUER=http://localhost:8081/realms/wagering
# Signing keys fetched through the internal network.
OIDC_JWKS_URL=http://keycloak:8080/realms/wagering/protocol/openid-connect/certs
OIDC_AUDIENCE=wagering-api

# --- AWS / LocalStack ---
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566
SQS_MAX_RECEIVE_COUNT=5

# --- Pending references (REFUND/ROLLBACK/WIN waiting for the referenced transaction) ---
PENDING_BASE_BACKOFF=1s
PENDING_MAX_BACKOFF=5m
PENDING_MAX_ATTEMPTS=10
PENDING_TTL=30m
PENDING_WORKERS=2
PENDING_POLL_INTERVAL=500ms
ENABLE_REFERENCE_WORKER=true

# --- SQS consumer (wager-transactions.fifo) ---
ENABLE_CONSUMER=true
SQS_CONSUMER_NAME=wallet-service
SQS_WORKERS=2
SQS_WAIT_TIME=20s
SQS_VISIBILITY_TIMEOUT=30s
SQS_HANDLER_TIMEOUT=20s
SQS_RETRY_BASE_DELAY=2s
SQS_RETRY_MAX_DELAY=5m
KNOWN_PROVIDERS=provider-a,provider-b

# --- Outbox publisher (wallet-events.fifo) ---
ENABLE_OUTBOX_PUBLISHER=true
OUTBOX_WORKERS=1
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE=30s
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_PUBLISH_TIMEOUT=10s
OUTBOX_RETRY_BASE_DELAY=1s
OUTBOX_RETRY_MAX_DELAY=5m
