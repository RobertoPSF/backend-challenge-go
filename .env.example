# --- Aplication ---
HTTP_ADDR=:8080

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wallet
WALLET_OWNER_PASSWORD=wallet_owner_local
WALLET_APP_PASSWORD=wallet_app_local

# Aplication connection (role without DDL and without UPDATE/DELETE on the ledger).
DATABASE_URL=postgres://wallet_app:wallet_app_local@postgres:5432/wallet?sslmode=disable

# Migrations usage only (role with DDL and DML).
DATABASE_MIGRATE_URL=postgres://wallet_owner:wallet_owner_local@postgres:5432/wallet?sslmode=disable

DB_MAX_CONNS=10
DB_LOCK_TIMEOUT=5s
DB_STATEMENT_TIMEOUT=10s

# --- Keycloak (IdP) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# --- AWS / LocalStack ---
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566
SQS_MAX_RECEIVE_COUNT=5
